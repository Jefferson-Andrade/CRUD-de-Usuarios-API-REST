# Somente desenvolvimento local. Copie para .env (ignorado pelo Git).
# Credenciais de banco novo; mudar aqui nao altera um volume ja inicializado.
POSTGRES_DB=crud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
API_PORT=8080

# Preencha ambas para criar o primeiro ADMIN; nao existe senha padrao.
# Use uma senha local unica: minimo 12 caracteres e maximo 72 bytes UTF-8.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
