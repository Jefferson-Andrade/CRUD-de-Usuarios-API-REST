# Modelo para um servico HTTPS e banco PostgreSQL exclusivos de demonstracao.
# Configure os valores no painel do provedor. Nunca versione senhas preenchidas.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
# Exemplo de formato, substitua host/banco e confira o TLS exigido pelo provedor.
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=verify-full
DB_USERNAME=
DB_PASSWORD=

# Provisionamento inicial. Nomes distintos; senhas unicas de 12 caracteres a 72 bytes UTF-8.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_DEMO_ENABLED=true
APP_DEMO_READER_USERNAME=
APP_DEMO_READER_PASSWORD=
# Ativar somente no banco de demonstracao para inserir tres registros ficticios.
APP_DEMO_SEED_DATA=false
# Depois do primeiro inicio: APP_DEMO_ENABLED=false, APP_DEMO_SEED_DATA=false;
# remover APP_ADMIN_USERNAME, APP_ADMIN_PASSWORD e APP_DEMO_READER_* do ambiente.
# As contas e os registros permanecem no PostgreSQL.
